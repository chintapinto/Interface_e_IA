class CameraDigifortBridge(BaseHTTPRequestHandler):
    # Configuração padrão do Digifort
    digifort_config = {
        'host': '192.168.1.110',
        'port': 8601,
        'username': 'admin',
        'password': 'gitel1987',
        'timeout': 10
    }
    
    # Configurações das câmeras (será carregado do arquivo)
    camera_configs = {}
    
    # Status do servidor
    server_status = {'running': False, 'stats': {'total_events': 0, 'successful': 0, 'failed': 0}}
    
    # Callback para atualizar GUI
    gui_callback = None
    
    @classmethod
    def set_gui_callback(cls, callback):
        cls.gui_callback = callback
    
    @classmethod
    def update_digifort_config(cls, config):
        cls.digifort_config.update(config)
    
    @classmethod
    def update_camera_configs(cls, configs):
        cls.camera_configs = configs
    
    def log_message(self, format, *args):
        """Override para usar nosso sistema de logging"""
        message = f"{self.address_string()} - {format % args}"
        logging.info(message)
        if self.gui_callback:
            self.gui_callback('log', message)
    
    def send_to_digifort(self, event_name, camera_ip):
        """Envia evento para o Digifort"""
        try:
            digifort_url = f"http://{self.digifort_config['host']}:{self.digifort_config['port']}/Interface/GlobalEvents/TriggerGlobalEvent"
            
            params = {
                'Event': event_name,
                'Source': f'Camera_{camera_ip.replace(".", "_")}',
                'Timestamp': datetime.datetime.now().isoformat()
            }
            
            auth = (self.digifort_config['username'], self.digifort_config['password'])
            headers = {
                'User-Agent': 'CameraBridge/2.0',
                'Content-Type': 'application/x-www-form-urlencoded'
            }
            
            logging.info(f"📡 Enviando para Digifort: {event_name} (Camera: {camera_ip})")
            
            response = requests.get(
                digifort_url,
                params=params,
                auth=auth,
                headers=headers,
                timeout=self.digifort_config['timeout']
            )
            
            if response.status_code == 200:
                logging.info(f"✅ Sucesso no Digifort! Status: {response.status_code}")
                self.server_status['stats']['successful'] += 1
                return True, response.text
            else:
                logging.error(f"❌ Erro no Digifort! Status: {response.status_code}")
                self.server_status['stats']['failed'] += 1
                return False, f"HTTP {response.status_code}: {response.text}"
                
        except requests.exceptions.Timeout:
            error_msg = f"⏰ Timeout ao conectar com Digifort ({self.digifort_config['timeout']}s)"
            logging.error(error_msg)
            self.server_status['stats']['failed'] += 1
            return False, error_msg
        except requests.exceptions.ConnectionError:
            error_msg = f"🔌 Erro de conexão com Digifort {self.digifort_config['host']}:{self.digifort_config['port']}"
            logging.error(error_msg)
            self.server_status['stats']['failed'] += 1
            return False, error_msg
        except Exception as e:
            error_msg = f"💥 Erro inesperado: {str(e)}"
            logging.error(error_msg)
            self.server_status['stats']['failed'] += 1
            return False, error_msg
    
    def process_camera_event(self, path, query_params):
        """Processa evento da câmera"""
        client_ip = self.client_address[0]
        timestamp = datetime.datetime.now().isoformat()
        
        # Incrementar contador de eventos
        self.server_status['stats']['total_events'] += 1
        
        # Verificar se a câmera está configurada
        if client_ip not in self.camera_configs:
            error_msg = f"❌ Câmera {client_ip} não configurada"
            logging.error(error_msg)
            if self.gui_callback:
                self.gui_callback('event', {
                    'timestamp': timestamp,
                    'camera_ip': client_ip,
                    'status': 'error',
                    'message': 'Câmera não configurada'
                })
            return {'success': False, 'error': 'Câmera não configurada'}
        
        camera_config = self.camera_configs[client_ip]
        
        # Extrair tipo de evento
        event_type = None
        for param in ['event', 'type', 'action']:
            if param in query_params and query_params[param]:
                event_type = query_params[param][0].lower()
                break
        
        if not event_type:
            event_type = 'unknown'
        
        # Determinar nome do evento para o Digifort
        digifort_event = None
        
        # Verificar mapeamentos específicos da câmera
        if event_type in camera_config.get('event_mapping', {}):
            digifort_event = camera_config['event_mapping'][event_type]
        else:
            # Usar evento padrão se não houver mapeamento específico
            digifort_event = camera_config.get('default_event', f"CAMERA_{client_ip.replace('.', '_')}_ALARM")
        
        logging.info(f"🎥 Evento da câmera {client_ip} ({camera_config.get('name', 'Sem nome')})")
        logging.info(f"📄 Mapeamento: '{event_type}' → '{digifort_event}'")
        
        # Enviar para Digifort
        success, response = self.send_to_digifort(digifort_event, client_ip)
        
        # Atualizar GUI
        if self.gui_callback:
            self.gui_callback('event', {
                'timestamp': timestamp,
                'camera_ip': client_ip,
                'camera_name': camera_config.get('name', 'Sem nome'),
                'original_event': event_type,
                'digifort_event': digifort_event,
                'status': 'success' if success else 'error',
                'message': 'Enviado com sucesso' if success else str(response)
            })
            
            # Atualizar estatísticas
            self.gui_callback('stats', self.server_status['stats'])
        
        return {
            'success': success,
            'digifort_event': digifort_event,
            'camera_name': camera_config.get('name', 'Sem nome')
        }
    
    def is_camera_allowed(self):
        """Verifica se a câmera está configurada"""
        client_ip = self.client_address[0]
        return client_ip in self.camera_configs
    
    def send_json_response(self, data, status_code=200):
        """Envia resposta JSON"""
        self.send_response(status_code)
        self.send_header('Content-type', 'application/json; charset=utf-8')
        self.end_headers()
        response = json.dumps(data, ensure_ascii=False, indent=2)
        self.wfile.write(response.encode('utf-8'))
    
    def do_GET(self):
        """Manipula requisições GET"""
        if not self.is_camera_allowed():
            client_ip = self.client_address[0]
            logging.warning(f"⚠️ Acesso negado para IP não autorizado: {client_ip}")
            self.send_json_response({
                'status': 'error',
                'message': f'IP {client_ip} não configurado'
            }, 403)
            return
        
        parsed_url = urlparse(self.path)
        query_params = parse_qs(parsed_url.query)
        
        result = self.process_camera_event(parsed_url.path, query_params)
        
        if result['success']:
            self.send_json_response({
                'status': 'success',
                'message': 'Evento processado com sucesso',
                'digifort_event': result['digifort_event'],
                'camera_name': result['camera_name']
            })
        else:
            self.send_json_response({
                'status': 'error',
                'message': result.get('error', 'Erro ao processar evento')
            }, 500)
    
    def do_POST(self):
        """Manipula requisições POST"""
        self.do_GET()  # Mesmo tratamento

