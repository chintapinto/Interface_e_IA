    def gui_callback(self, event_type, data):
        """Callback para atualizar a GUI a partir do servidor"""
        def update_gui():
            if event_type == 'log':
                timestamp = datetime.datetime.now().strftime('%H:%M:%S')
                self.event_log.insert(tk.END, f"[{timestamp}] {data}\n")
                self.event_log.see(tk.END)
            
            elif event_type == 'event':
                timestamp = data['timestamp'][:19].replace('T', ' ')
                status_color = 'success' if data['status'] == 'success' else 'error'
                
                message = f"[{timestamp}] {data['camera_name']} ({data['camera_ip']}) - "
                message += f"{data['original_event']} → {data['digifort_event']} - {data['message']}\n"
                
                self.event_log.insert(tk.END, message, status_color)
                self.event_log.see(tk.END)
            
            elif event_type == 'stats':
                stats_text = f"Eventos: {data['total_events']} | Sucessos: {data['successful']} | Falhas: {data['failed']}"
                self.stats_label.config(text=stats_text)
        
        # Executar na thread principal
        self.root.after(0, update_gui)
    
    def add_camera(self):
        """Adiciona nova câmera"""
        ip = self.ip_entry.get().strip()
        name = self.name_entry.get().strip()
        default_event = self.default_event_entry.get().strip()
        
        if not ip or not name:
            messagebox.showerror("Erro", "IP e Nome são obrigatórios!")
            return
        
        if ip in self.camera_configs:
            messagebox.showerror("Erro", "Essa câmera já está configurada!")
            return
        
        self.camera_configs[ip] = {
            'name': name,
            'default_event': default_event or f"CAMERA_{ip.replace('.', '_')}_ALARM",
            'event_mapping': {}
        }
        
        # Limpar formulário
        self.ip_entry.delete(0, tk.END)
        self.name_entry.delete(0, tk.END)
        self.default_event_entry.delete(0, tk.END)
        
        self.update_camera_list()
        self.save_config()
        messagebox.showinfo("Sucesso", "Câmera adicionada com sucesso!")
    
    def edit_camera(self):
        """Edita câmera selecionada"""
        selection = self.camera_tree.selection()
        if not selection:
            messagebox.showwarning("Aviso", "Selecione uma câmera para editar!")
            return
        
        item = self.camera_tree.item(selection[0])
        ip = item['values'][0]
        
        # Janela de edição
        edit_window = tk.Toplevel(self.root)
        edit_window.title(f"Editar Câmera {ip}")
        edit_window.geometry("400x200")
        
        ttk.Label(edit_window, text="Nome:").pack(pady=5)
        name_entry = ttk.Entry(edit_window, width=40)
        name_entry.pack(pady=5)
        name_entry.insert(0, self.camera_configs[ip]['name'])
        
        ttk.Label(edit_window, text="Evento Padrão:").pack(pady=5)
        event_entry = ttk.Entry(edit_window, width=40)
        event_entry.pack(pady=5)
        event_entry.insert(0, self.camera_configs[ip]['default_event'])
        
        def save_changes():
            self.camera_configs[ip]['name'] = name_entry.get()
            self.camera_configs[ip]['default_event'] = event_entry.get()
            self.update_camera_list()
            self.save_config()
            edit_window.destroy()
            messagebox.showinfo("Sucesso", "Câmera atualizada!")
        
        ttk.Button(edit_window, text="Salvar", command=save_changes).pack(pady=10)
    
    def remove_camera(self):
        """Remove câmera selecionada"""
        selection = self.camera_tree.selection()
        if not selection:
            messagebox.showwarning("Aviso", "Selecione uma câmera para remover!")
            return
        
        item = self.camera_tree.item(selection[0])
        ip = item['values'][0]
        
        if messagebox.askyesno("Confirmar", f"Remover câmera {ip}?"):
            del self.camera_configs[ip]
            self.update_camera_list()
            self.save_config()
            messagebox.showinfo("Sucesso", "Câmera removida!")
    
    def configure_mappings(self):
        """Configura mapeamentos de eventos da câmera"""
        selection = self.camera_tree.selection()
        if not selection:
            messagebox.showwarning("Aviso", "Selecione uma câmera para configurar!")
            return
        
        item = self.camera_tree.item(selection[0])
        ip = item['values'][0]
        camera = self.camera_configs[ip]
        
        # Janela de mapeamentos
        map_window = tk.Toplevel(self.root)
        map_window.title(f"Mapeamentos - {camera['name']} ({ip})")
        map_window.geometry("600x400")
        
        ttk.Label(map_window, text="Mapeamento de Eventos:", font=('Arial', 12, 'bold')).pack(pady=10)
        ttk.Label(map_window, text="Evento da Câmera → Evento do Digifort").pack()
        
        # Frame para mapeamentos
        map_frame = ttk.Frame(map_window)
        map_frame.pack(fill=tk.BOTH, expand=True, padx=20, pady=20)
        
        # Lista de mapeamentos
        map_tree = ttk.Treeview(map_frame, columns=('Câmera', 'Digifort'), show='headings', height=10)
        map_tree.heading('Câmera', text='Evento da Câmera')
        map_tree.heading('Digifort', text='Evento do Digifort')
        map_tree.column('Câmera', width=200)
        map_tree.column('Digifort', width=250)
        map_tree.pack(fill=tk.BOTH, expand=True)
        
        # Carregar mapeamentos existentes
        def load_mappings():
            for item in map_tree.get_children():
                map_tree.delete(item)
            for cam_event, dig_event in camera['event_mapping'].items():
                map_tree.insert('', tk.END, values=(cam_event, dig_event))
        
        load_mappings()
        
        # Formulário para adicionar mapeamento
        add_frame = ttk.Frame(map_window)
        add_frame.pack(fill=tk.X, padx=20, pady=10)
        
        ttk.Label(add_frame, text="Evento Câmera:").grid(row=0, column=0, padx=(0, 10))
        cam_event_entry = ttk.Entry(add_frame, width=20)
        cam_event_entry.grid(row=0, column=1, padx=(0, 20))
        
        ttk.Label(add_frame, text="Evento Digifort:").grid(row=0, column=2, padx=(0, 10))
        dig_event_entry = ttk.Entry(add_frame, width=30)
        dig_event_entry.grid(row=0, column=3, padx=(0, 20))
        
        def add_mapping():
            cam_event = cam_event_entry.get().strip().lower()
            dig_event = dig_event_entry.get().strip()
            
            if cam_event and dig_event:
                camera['event_mapping'][cam_event] = dig_event
                cam_event_entry.delete(0, tk.END)
                dig_event_entry.delete(0, tk.END)
                load_mappings()
        
        def remove_mapping():
            selection = map_tree.selection()
            if selection:
                item = map_tree.item(selection[0])
                cam_event = item['values'][0]
                if cam_event in camera['event_mapping']:
                    del camera['event_mapping'][cam_event]
                    load_mappings()
        
        ttk.Button(add_frame, text="Adicionar", command=add_mapping).grid(row=0, column=4)
        
        button_frame = ttk.Frame(map_window)
        button_frame.pack(pady=10)
        
        ttk.Button(button_frame, text="Remover Selecionado", command=remove_mapping).pack(side=tk.LEFT, padx=(0, 10))
        
        def save_mappings():
            self.update_camera_list()
            self.save_config()
            map_window.destroy()
            messagebox.showinfo("Sucesso", "Mapeamentos salvos!")
        
        ttk.Button(button_frame, text="Salvar e Fechar", command=save_mappings).pack(side=tk.LEFT)
    
    def update_camera_list(self):
        """Atualiza lista de câmeras"""
        for item in self.camera_tree.get_children():
            self.camera_tree.delete(item)
        
        for ip, config in self.camera_configs.items():
            mappings_count = len(config.get('event_mapping', {}))
            mappings_text = f"{mappings_count} mapeamento(s)"
            
            self.camera_tree.insert('', tk.END, values=(
                ip,
                config['name'],
                config['default_event'],
                mappings_text
            ))
    
    def save_digifort_config(self):
        """Salva configuração do Digifort"""
        try:
            self.digifort_config = {
                'host': self.df_host_entry.get(),
                'port': int(self.df_port_entry.get()),
                'username': self.df_user_entry.get(),
                'password': self.df_pass_entry.get(),
                'timeout': 10
            }
            
            CameraDigifortBridge.update_digifort_config(self.digifort_config)
            self.save_config()
            messagebox.showinfo("Sucesso", "Configuração do Digifort salva!")
            
        except ValueError:
            messagebox.showerror("Erro", "Porta deve ser um número!")
    
    def update_digifort_config_display(self):
        """Atualiza display da configuração do Digifort"""
        self.df_host_entry.delete(0, tk.END)
        self.df_host_entry.insert(0, self.digifort_config['host'])
        
        self.df_port_entry.delete(0, tk.END)
        self.df_port_entry.insert(0, str(self.digifort_config['port']))
        
        self.df_user_entry.delete(0, tk.END)
        self.df_user_entry.insert(0, self.digifort_config['username'])
        
        self.df_pass_entry.delete(0, tk.END)
        self.df_pass_entry.insert(0, self.digifort_config['password'])
    
    def test_digifort_connection(self):
        """Testa conexão com Digifort"""
        try:
            url = f"http://{self.digifort_config['host']}:{self.digifort_config['port']}/Interface/GlobalEvents/TriggerGlobalEvent"
            auth = (self.digifort_config['username'], self.digifort_config['password'])
            params = {'Event': 'BRIDGE_TEST'}
            
            response = requests.get(url, params=params, auth=auth, timeout=5)
            
            if response.status_code == 200:
                messagebox.showinfo("Sucesso", "✅ Conexão com Digifort OK!")
            else:
                messagebox.showerror("Erro", f"❌ Digifort retornou status: {response.status_code}")
                
        except requests.exceptions.Timeout:
            messagebox.showerror("Erro", "⏰ Timeout - Verifique o IP e porta")
        except requests.exceptions.ConnectionError:
            messagebox.showerror("Erro", "🔌 Erro de conexão - Verifique se o Digifort está rodando")
        except Exception as e:
            messagebox.showerror("Erro", f"💥 Erro: {str(e)}")
    
    def start_server(self):
        """Inicia servidor bridge"""
        if not self.camera_configs:
            messagebox.showwarning("Aviso", "Configure pelo menos uma câmera antes de iniciar!")
            return
        
        try:
            # Atualizar configurações no servidor
            CameraDigifortBridge.update_camera_configs(self.camera_configs)
            CameraDigifortBridge.update_digifort_config(self.digifort_config)
            
            # Iniciar servidor
            host = self.digifort_config['host']  # Mesmo IP do Digifort
            port = 8080  # Porta do bridge
            
            self.server = HTTPServer((host, port), CameraDigifortBridge)
            CameraDigifortBridge.server_status['running'] = True
            
            # Iniciar em thread separada
            self.server_thread = threading.Thread(target=self.server.serve_forever, daemon=True)
            self.server_thread.start()
            
            # Atualizar interface
            self.status_label.config(text=f"🟢 Rodando em {host}:{port}", foreground='green')
            self.start_button.config(state=tk.DISABLED)
            self.stop_button.config(state=tk.NORMAL)
            
            # Log inicial
            self.event_log.insert(tk.END, f"🚀 Servidor iniciado em {host}:{port}\n", 'info')
            self.event_log.insert(tk.END, f"📹 Câmeras configuradas: {len(self.camera_configs)}\n", 'info')
            
            for ip, config in self.camera_configs.items():
                self.event_log.insert(tk.END, f"   • {config['name']} ({ip}) → {config['default_event']}\n", 'info')
            
            self.event_log.insert(tk.END, f"🎯 Digifort: {self.digifort_config['host']}:{self.digifort_config['port']}\n", 'info')
            self.event_log.insert(tk.END, "📡 Configure suas câmeras para enviarem eventos para:\n", 'info')
            self.event_log.insert(tk.END, f"   http://{host}:{port}/cgi-bin/alarm.cgi?event=start\n", 'info')
            self.event_log.insert(tk.END, f"   http://{host}:{port}/cgi-bin/alarm.cgi?event=end\n", 'info')
            self.event_log.see(tk.END)
            
            messagebox.showinfo("Sucesso", f"Servidor iniciado com sucesso!\n\nConfiguração das câmeras:\nhttp://{host}:{port}/cgi-bin/alarm.cgi?event=start")
            
        except OSError as e:
            messagebox.showerror("Erro", f"Erro ao iniciar servidor: {e}\nVerifique se a porta não está em uso.")
        except Exception as e:
            messagebox.showerror("Erro", f"Erro inesperado: {e}")
    
    def stop_server(self):
        """Para servidor bridge"""
        if self.server:
            try:
                self.server.shutdown()
                self.server.server_close()
                self.server = None
                
                CameraDigifortBridge.server_status['running'] = False
                
                # Atualizar interface
                self.status_label.config(text="🔴 Parado", foreground='red')
                self.start_button.config(state=tk.NORMAL)
                self.stop_button.config(state=tk.DISABLED)
                
                self.event_log.insert(tk.END, "🛑 Servidor parado\n", 'info')
                self.event_log.see(tk.END)
                
                messagebox.showinfo("Sucesso", "Servidor parado com sucesso!")
                
            except Exception as e:
                messagebox.showerror("Erro", f"Erro ao parar servidor: {e}")
    
    def save_config(self):
        """Salva configurações em arquivo"""
        config = {
            'digifort_config': self.digifort_config,
            'camera_configs': self.camera_configs
        }
        
        try:
            with open('bridge_config.json', 'w', encoding='utf-8') as f:
                json.dump(config, f, indent=2, ensure_ascii=False)
        except Exception as e:
            messagebox.showerror("Erro", f"Erro ao salvar configuração: {e}")
    
    def load_config(self):
        """Carrega configurações do arquivo"""
        try:
            if os.path.exists('bridge_config.json'):
                with open('bridge_config.json', 'r', encoding='utf-8') as f:
                    config = json.load(f)
                
                if 'digifort_config' in config:
                    self.digifort_config.update(config['digifort_config'])
                
                if 'camera_configs' in config:
                    self.camera_configs = config['camera_configs']
                    
        except Exception as e:
            messagebox.showerror("Erro", f"Erro ao carregar configuração: {e}")

def main():
    """Função principal"""
    root = tk.Tk()
    app = CameraBridgeGUI(root)
    
    def on_closing():
        if app.server:
            app.stop_server()
        root.destroy()
    
    root.protocol("WM_DELETE_WINDOW", on_closing)
    
    # Tentar definir ícone (opcional)
    try:
        root.iconbitmap('bridge.ico')
    except:
        pass
    
    root.mainloop()

if __name__ == '__main__':
    main()
